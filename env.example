# Database Configuration
POSTGRES_USER=todouser
POSTGRES_PASSWORD=todopassword
POSTGRES_DB=tododb
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=3000
NODE_ENV=production

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please-use-a-random-string

# Note: DATABASE_URL is automatically constructed by docker-compose.yml
# It will be: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

